{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:editor && npm run build:performance && vite build",
    "build:editor": "esbuild src/admin-editor.ts --bundle --minify --format=iife --target=es2022 --outfile=public/static/rich-editor.js",
    "build:performance": "esbuild src/performance-client.ts --bundle --minify --format=iife --target=es2022 --outfile=public/static/performance.js",
    "test:care": "node tests/care.mjs",
    "test:foundations": "node tests/foundations.mjs",
    "test": "node tests/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply webapp-production --local",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy ../dist --cwd deployment --project-name webapp-2 --branch main",
    "db:migrate:production": "wrangler d1 migrations apply webapp-2-goodmorning-production --config deployment/wrangler.jsonc --remote",
    "test:production": "node tests/production.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test:studio": "node tests/studio.mjs",
    "test:navigation": "node tests/navigation.mjs",
    "test:seo": "node tests/seo-mobile.mjs",
    "test:locales": "node tests/locales.mjs",
    "test:services": "node tests/services.mjs",
    "test:operations": "node tests/notification-unit.mjs && node tests/operations.mjs",
    "test:operations:production": "node tests/operations-production.mjs",
    "test:editorial": "node tests/editorial.mjs",
    "test:all": "npm run test:navigation && npm test && npm run test:studio && npm run test:seo && npm run test:services && npm run test:locales && npm run test:editorial && npm run test:local-seo",
    "test:local-seo": "node tests/local-seo.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-image": "3.31.4",
    "@tiptap/extension-placeholder": "3.31.4",
    "@tiptap/extension-table": "3.31.4",
    "@tiptap/markdown": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.8",
    "marked": "18.1.0",
    "web-vitals": "6.2.3"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.63.0",
    "esbuild": "0.28.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
