{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node tests/smoke.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply webapp-production --local",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test:studio": "node tests/studio.mjs",
    "test:navigation": "node tests/navigation.mjs",
    "test:all": "npm run test:navigation && npm test && npm run test:studio"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.8"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
