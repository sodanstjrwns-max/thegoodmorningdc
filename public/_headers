# Static asset caching (Cloudflare Pages). CSS/JS are always referenced with a ?v= version that is
# bumped on change, and fonts never change in place, so they are cached long-term and immutable.
/static/*.css
  Cache-Control: public, max-age=31536000, immutable
/static/*.js
  Cache-Control: public, max-age=31536000, immutable
/static/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/static/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/static/video/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
/static/*.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
/static/fees-0324.pdf
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
